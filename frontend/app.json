{
  "expo": {
    "name": "fituus",
    "slug": "fituus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/fituus-icon-v2.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/fituus-icon-v2.png",
      "bundleIdentifier": "com.angelaminiello.fituus",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/branding/fituus-icon-foreground-v2.png",
        "monochromeImage": "./assets/branding/fituus-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.angelaminiello.fituus"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/fituus-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6c1ff81-e535-4821-806a-ee16c8476645"
      }
    },
    "owner": "angelaminiello"
  }
}
